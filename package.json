{
  "name": "people-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite --mode development",
    "dev:api": "tsx --env-file=.env scripts/dev-api.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "keygen": "tsx scripts/generate-delegate-key.ts",
    "verify": "npm run verify:codec && npm run verify:rank && npm run verify:isolation && npm run verify:dates && npm run verify:tasks && npm run verify:patterns && npm run verify:unread && npm run verify:prompt && npm run verify:timezone && npm run verify:opening && npm run verify:store && npm run verify:delegate && npm run verify:book && npm run verify:chat",
    "verify:codec": "tsx scripts/verify-memory-codec.ts",
    "verify:rank": "tsx scripts/verify-ranking.ts",
    "check:registry": "tsx scripts/check-registry.ts",
    "live:check": "tsx scripts/live-memory-check.ts",
    "verify:isolation": "tsx scripts/verify-isolation.ts",
    "verify:signin": "tsx --env-file=.env scripts/verify-signin.ts",
    "verify:chat": "tsx --env-file=.env scripts/verify-chat.ts",
    "verify:ui": "node scripts/verify-ui.mjs",
    "shots": "node scripts/shots.mjs",
    "icons": "node scripts/gen-icons.mjs",
    "verify:tasks": "tsx scripts/verify-tasks.ts",
    "verify:patterns": "tsx scripts/verify-patterns.ts",
    "verify:unread": "tsx scripts/verify-unread.ts",
    "verify:prompt": "tsx scripts/verify-prompt.ts",
    "verify:timezone": "tsx scripts/verify-timezone.ts",
    "verify:opening": "tsx scripts/verify-opening.ts",
    "verify:store": "tsx scripts/verify-store-cache.ts",
    "verify:build": "node scripts/verify-build.mjs",
    "verify:dates": "tsx scripts/verify-dates.ts",
    "verify:deploy": "node scripts/verify-deploy.mjs",
    "verify:delegate": "tsx scripts/verify-delegate.ts",
    "verify:book": "tsx scripts/verify-book.ts"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@hono/node-server": "^1.19.7",
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/dapp-kit-react": "^2.1.37",
    "@mysten/sui": "^2.33.2",
    "hono": "^4.13.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "playwright": "^1.63.0",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "license": "MIT",
  "engines": {
    "node": "22.x"
  }
}
