{
  "name": "people-book",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "tsx scripts/dev-api.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "keygen": "tsx scripts/generate-delegate-key.ts",
    "verify": "npm run verify:codec && npm run verify:rank",
    "verify:codec": "tsx scripts/verify-memory-codec.ts",
    "verify:rank": "tsx scripts/verify-ranking.ts",
    "check:registry": "tsx scripts/check-registry.ts"
  },
  "dependencies": {
    "@google/genai": "^1.30.0",
    "@hono/node-server": "^1.19.7",
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/dapp-kit-react": "^2.1.37",
    "@mysten/sui": "^2.33.2",
    "ai": "^7.0.107",
    "hono": "^4.13.12",
    "jose": "^6.2.12",
    "lucide-react": "^0.544.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.1",
    "@types/node": "^22.13.10",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.1",
    "tsx": "^4.23.13",
    "typescript": "^5.8.2",
    "vite": "^7.1.9"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
