{
  "name": "walprompt",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"api,vite\" -c \"cyan,magenta\" \"uvicorn api.index:app --host 0.0.0.0 --port 8000 --reload\" \"vite\"",
    "dev:ui": "vite",
    "dev:api": "uvicorn api.index:app --host 0.0.0.0 --port 8000 --reload",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@mysten/dapp-kit": "^1.1.4",
    "@mysten/sui": "^2.20.2",
    "@tanstack/react-query": "^5.101.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1"
  }
}
